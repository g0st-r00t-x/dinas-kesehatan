{
    # Global options
    admin off
    auto_https off

    frankenphp {
        worker /app/public/frankenphp-worker.php 4
    }
}

:8082 {
    # Set document root to Laravel public directory
    root * /app/public

    # Enable logs
    log {
        output file /var/log/caddy/access.log
        format json
    }

    # Serve PHP with FrankenPHP
    php_server

    # Handle static files with proper permissions
    @static {
        path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot
    }
    
    header @static {
        Cache-Control "public, max-age=31536000"
        # Remove Permissions-Policy for static files to avoid issues
        -Permissions-Policy
    }

    # File server with better caching for assets
    file_server {
        precompressed br gzip
    }

    # Enable compression
    encode gzip zstd

    # Set security headers for non-static files
    header {
        # Enable HSTS
        Strict-Transport-Security "max-age=31536000;"
        # Disable FLoC tracking
        Permissions-Policy "interest-cohort=()"
        # Enable XSS filtering
        X-XSS-Protection "1; mode=block"
        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"
        # Disable iframe embedding from other domains
        X-Frame-Options "SAMEORIGIN"
        # Remove the Server header
        -Server
    }
}

# Websockets for Reverb on a separate port
:8081 {
    reverse_proxy localhost:{$REVERB_PORT}
}